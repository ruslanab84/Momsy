<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>

	<!-- No cross-app tracking -->
	<key>NSPrivacyTracking</key>
	<false/>
	<key>NSPrivacyTrackingDomains</key>
	<array/>

	<!-- ──────────────────────────────────────────────────────────
	     Required-Reason APIs
	     ────────────────────────────────────────────────────────── -->
	<key>NSPrivacyAccessedAPITypes</key>
	<array>

		<!-- UserDefaults — app preferences and shared App Group preferences -->
		<dict>
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryUserDefaults</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<!-- CA92.1: read/write own app preferences only -->
				<string>CA92.1</string>
				<!-- 1C8F.1: read/write preferences shared through an App Group -->
				<string>1C8F.1</string>
			</array>
		</dict>

	</array>

	<!-- ──────────────────────────────────────────────────────────
	     Collected data types (App Store nutrition label)
	     ────────────────────────────────────────────────────────── -->
	<key>NSPrivacyCollectedDataTypes</key>
	<array>

		<!-- Baby name entered during onboarding, stored locally + Firebase -->
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeName</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>

		<!-- Baby health data: feeding logs, sleep records, temperature, growth
		     measurements, diaper/stool, vaccinations. Stored locally (SwiftData) and
		     synced to the developer's Firebase backend (Cloud Firestore) under the
		     user's Firebase Auth account — therefore linked to the user's identity. -->
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeHealth</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>

		<!-- Parent mental-health data (MomMoodRecord: mood, energy, note, EPDS
		     postpartum-depression score) is deliberately NOT declared: it never leaves
		     the device, so it is not "collected" under Apple's definition. `momMood` has
		     no Firestore subcollection or CloudSyncDownloader wiring. Guarded by
		     MomMoodStaysLocalTests. -->

		<!-- Diary text and other free-form records are synced to Firestore when cloud
		     consent is enabled. -->
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeOtherUserContent</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>

		<!-- Stable anonymous or provider-backed Firebase Authentication user id -->
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeUserID</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>

		<!-- Email is collected only when supplied by Apple or Google sign-in -->
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeEmailAddress</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>

	</array>

</dict>
</plist>
