rules_version = '2';

// Firestore security rules for Momsy.
//
// Data model:
//   users/{uid}                                   -> per-user doc, carries familyId
//   families/{familyId}                           -> family doc (createdBy)
//   families/{familyId}/members/{uid}             -> member roster
//   families/{familyId}/babies/{babyId}/**        -> baby profile + per-baby log tree (current)
//   invites/{code}                                -> short-lived join codes (familyId)
//   babies/{familyId}/**                          -> LEGACY family-keyed log tree (pre-migration)
//
// Membership is derived from the caller's own users/{uid}.familyId field so a member can
// be authorised without first reading the members subcollection. The family creator is
// authorised separately for the brief window during family setup when the members doc is
// written before users/{uid}.familyId has been committed (see FamilyManager.setup).

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function hasUserDoc() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function callerFamilyId() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.familyId;
    }

    function isFamilyMember(familyId) {
      return hasUserDoc() && callerFamilyId() == familyId;
    }

    // True during family setup: the caller created families/{familyId} (createdBy == uid)
    // but has not yet written users/{uid}.familyId.
    function isFamilyCreator(familyId) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/families/$(familyId))
        && get(/databases/$(database)/documents/families/$(familyId)).data.createdBy == request.auth.uid;
    }

    function belongsToFamily(familyId) {
      return isFamilyMember(familyId) || isFamilyCreator(familyId);
    }

    function hasCallerMemberDoc(familyId) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/families/$(familyId)/members/$(request.auth.uid));
    }

    function callerRoleRaw(familyId) {
      return get(/databases/$(database)/documents/families/$(familyId)/members/$(request.auth.uid)).data.roleRaw;
    }

    function canManageFamilyRoster(familyId) {
      return belongsToFamily(familyId)
        && hasCallerMemberDoc(familyId)
        && callerRoleRaw(familyId) in ['Мама', 'Папа'];
    }

    function isSelfMemberWrite(familyId, memberId) {
      return isSignedIn()
        && memberId == request.auth.uid
        && (isFamilyMember(familyId) || isFamilyCreator(familyId));
    }

    function memberRoleUnchanged() {
      return !('roleRaw' in resource.data)
        || request.resource.data.roleRaw == resource.data.roleRaw;
    }

    // Each user owns only their own doc.
    match /users/{uid} {
      allow read, write: if isSignedIn() && request.auth.uid == uid;
    }

    // A signed-in user may look up ONE invite by its exact code to discover the
    // familyId to join — but only while it is unexpired. `list` is denied outright:
    // allowing it would let any signed-in user enumerate every family's code and
    // familyId, then self-assign membership via their own users/{uid} doc.
    // Only full-access members of the referenced family may create/replace or delete a code.
    match /invites/{code} {
      allow get:            if isSignedIn()
                            && resource.data.expiresAt > request.time;
      allow list:           if false;
      allow create, update: if canManageFamilyRoster(request.resource.data.familyId);
      allow delete:         if canManageFamilyRoster(resource.data.familyId);
    }

    match /families/{familyId} {
      allow read:          if belongsToFamily(familyId);
      allow create:        if isSignedIn() && request.resource.data.createdBy == request.auth.uid;
      allow update, delete: if belongsToFamily(familyId);

      // Members roster. A joining member may write their own membership doc; the family
      // creator may write during setup; Mom/Dad members may manage the roster.
      match /members/{memberId} {
        allow read:   if belongsToFamily(familyId);
        allow create: if canManageFamilyRoster(familyId)
                      || isSelfMemberWrite(familyId, memberId);
        allow update: if canManageFamilyRoster(familyId)
                      || (isSelfMemberWrite(familyId, memberId) && memberRoleUnchanged());
        allow delete: if canManageFamilyRoster(familyId)
                      || (isSignedIn() && memberId == request.auth.uid);
      }

      // Per-baby tree: profile parent doc + every log subcollection.
      match /babies/{babyId}/{document=**} {
        allow read, write: if belongsToFamily(familyId);
      }
    }

    // LEGACY family-keyed log tree, still read/written during the per-baby migration
    // rollout. Remove this block once all clients have migrated to the per-baby path.
    match /babies/{familyId}/{document=**} {
      allow read, write: if belongsToFamily(familyId);
    }
  }
}
