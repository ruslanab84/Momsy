rules_version = '2';

// Firestore security rules for Momsy.
//
// Data model:
//   users/{uid}                                   -> per-user routing/cache doc
//   families/{familyId}                           -> family doc (createdBy)
//   families/{familyId}/members/{uid}             -> member roster
//   families/{familyId}/babies/{babyId}/**        -> baby profile + per-baby log tree (current)
//   invites/{code}                                -> short-lived join codes (familyId)
//   babies/{familyId}/**                          -> LEGACY family-keyed log tree (pre-migration)
//
// Access is authorised by families/{familyId}/members/{uid}. users/{uid}.familyId is
// only a routing/cache field and must never grant family access by itself.

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isFamilyMember(familyId) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/families/$(familyId)/members/$(request.auth.uid));
    }

    function familyExists(familyId) {
      return familyId is string
        && exists(/databases/$(database)/documents/families/$(familyId));
    }

    function isFamilyMemberAfter(familyId) {
      return isSignedIn()
        && getAfter(/databases/$(database)/documents/families/$(familyId)/members/$(request.auth.uid)).data.uid == request.auth.uid;
    }

    // True only during initial family setup before the creator has written their
    // own member doc and the app marks bootstrapComplete.
    function isFamilyCreator(familyId) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/families/$(familyId))
        && get(/databases/$(database)/documents/families/$(familyId)).data.createdBy == request.auth.uid
        && get(/databases/$(database)/documents/families/$(familyId)).data.bootstrapComplete == false;
    }

    function belongsToFamily(familyId) {
      return isFamilyMember(familyId);
    }

    // Право на удаление: создатель снимает свой UID с семейного документа, уходя из
    // ростера. Сам документ остаётся неповторно используемым tombstone'ом (delete
    // запрещён всем), но перестаёт хранить идентификатор стёртого пользователя.
    // Client cleanup still clears it atomically; the departure trigger is the
    // retryable fallback for roster removals and interrupted exits.
    function isCreatorSelfErasure(familyId) {
      return isSignedIn()
        && resource.data.createdBy == request.auth.uid
        && request.resource.data.createdBy == ''
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['createdBy'])
        && !existsAfter(
          /databases/$(database)/documents/families/$(familyId)/members/$(request.auth.uid)
        );
    }

    function callerRoleRaw(familyId) {
      return get(/databases/$(database)/documents/families/$(familyId)/members/$(request.auth.uid)).data.roleRaw;
    }

    function isParentRole(roleRaw) {
      return roleRaw in [
        'Мама', 'Папа',
        'мама', 'папа',
        'mom', 'dad',
        'Mom', 'Dad',
        'mama', 'papa',
        'mother', 'father',
        'parent', 'Parent'
      ];
    }

    // One-shot setup for new clients: the family cannot become visible without
    // its creator membership and user routing committing in the same batch.
    function isAtomicFamilyCreatorBootstrap(familyId) {
      let familyPath = /databases/$(database)/documents/families/$(familyId);
      let memberPath = /databases/$(database)/documents/families/$(familyId)/members/$(request.auth.uid);
      let userPath = /databases/$(database)/documents/users/$(request.auth.uid);
      return isSignedIn()
        && !exists(familyPath)
        && !exists(memberPath)
        && getAfter(familyPath).data.createdBy == request.auth.uid
        && getAfter(familyPath).data.bootstrapComplete == true
        && getAfter(memberPath).data.uid == request.auth.uid
        && isParentRole(getAfter(memberPath).data.roleRaw)
        && getAfter(userPath).data.familyId == familyId;
    }

    // Read the roster pre-state: getAfter() would let a removed inviter recreate
    // their own parent member document in the same join batch.
    function isActiveParentMember(familyId, uid) {
      return uid is string
        && exists(/databases/$(database)/documents/families/$(familyId)/members/$(uid))
        && isParentRole(
          get(/databases/$(database)/documents/families/$(familyId)/members/$(uid)).data.roleRaw
        );
    }

    function isNannyRole(roleRaw) {
      return roleRaw in ['Няня', 'няня', 'nanny', 'Nanny'];
    }

    function isGrandmaRole(roleRaw) {
      return roleRaw in [
        'Бабушка', 'бабушка',
        'grandma', 'Grandma',
        'grandmother', 'Grandmother'
      ];
    }

    function canManageFamilyRoster(familyId) {
      return belongsToFamily(familyId)
        && isParentRole(callerRoleRaw(familyId));
    }

    function canTrackBaby(familyId) {
      return belongsToFamily(familyId)
        && isNannyRole(callerRoleRaw(familyId));
    }

    function canViewBabyStatus(familyId) {
      return belongsToFamily(familyId)
        && (
          isParentRole(callerRoleRaw(familyId))
          || isNannyRole(callerRoleRaw(familyId))
          || isGrandmaRole(callerRoleRaw(familyId))
        );
    }

    function isRoutineTrackingCollection(subcollection) {
      return subcollection in [
        'feedingLogs', 'sleepLogs', 'diaperLogs', 'stoolLogs',
        'walkLogs', 'bathLogs', 'leapLogs'
      ];
    }

    function isPrivateWellbeingCollection(subcollection) {
      return subcollection in ['momSleepLogs', 'waterIntakeLogs'];
    }

    function canReadBabyCollection(familyId, subcollection) {
      return !isPrivateWellbeingCollection(subcollection)
        && (
          canManageFamilyRoster(familyId)
        || (
          canViewBabyStatus(familyId)
          && (
            isRoutineTrackingCollection(subcollection)
            || subcollection == 'deletions'
          )
        )
      );
    }

    function hasValidRoutineAuthor() {
      return request.resource.data.keys().hasAll(['addedBy', 'addedByName'])
        && request.resource.data.addedBy is string
        && request.resource.data.addedBy == request.auth.uid
        && request.resource.data.addedByName is string;
    }

    function canCreateRoutineLog(familyId, subcollection) {
      return canTrackBaby(familyId)
        && isRoutineTrackingCollection(subcollection)
        && hasValidRoutineAuthor();
    }

    function canUpdateRoutineLog(familyId, subcollection) {
      return canTrackBaby(familyId)
        && isRoutineTrackingCollection(subcollection)
        && resource.data.addedBy == request.auth.uid
        && hasValidRoutineAuthor();
    }

    function canListOwnAuthoredData(familyId) {
      return belongsToFamily(familyId)
        && resource.data.addedBy == request.auth.uid;
    }

    function canCreatePrivateWellbeing(familyId, subcollection) {
      return isPrivateWellbeingCollection(subcollection)
        && (canManageFamilyRoster(familyId) || isFamilyCreator(familyId))
        && hasValidRoutineAuthor();
    }

    function canUpdatePrivateWellbeing(familyId, subcollection) {
      return isPrivateWellbeingCollection(subcollection)
        && (canManageFamilyRoster(familyId) || isFamilyCreator(familyId))
        && resource.data.addedBy == request.auth.uid
        && hasValidRoutineAuthor();
    }

    function canDeletePrivateWellbeing(familyId, subcollection) {
      return isPrivateWellbeingCollection(subcollection)
        && canManageFamilyRoster(familyId)
        && resource.data.addedBy == request.auth.uid;
    }

    function anonymizesOwnAuthorMetadata(familyId) {
      return belongsToFamily(familyId)
        && resource.data.addedBy == request.auth.uid
        && request.resource.data.addedBy == ''
        && request.resource.data.addedByName == ''
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['addedBy', 'addedByName']);
    }

    function hasInviteCode() {
      return 'inviteCode' in request.resource.data
        && request.resource.data.inviteCode is string;
    }

    function inviteMatchesFamily(familyId) {
      return hasInviteCode()
        && familyExists(familyId)
        && exists(/databases/$(database)/documents/invites/$(request.resource.data.inviteCode))
        && get(/databases/$(database)/documents/invites/$(request.resource.data.inviteCode)).data.familyId == familyId
        && get(/databases/$(database)/documents/invites/$(request.resource.data.inviteCode)).data.expiresAt > request.time
        && isActiveParentMember(
          familyId,
          get(/databases/$(database)/documents/invites/$(request.resource.data.inviteCode)).data.createdBy
        );
    }

    function memberRoleMatchesInvite() {
      return request.resource.data.roleRaw
        == get(/databases/$(database)/documents/invites/$(request.resource.data.inviteCode)).data.roleRaw;
    }

    function inviteIsDeletedAfterJoin() {
      return !existsAfter(
        /databases/$(database)/documents/invites/$(request.resource.data.inviteCode)
      );
    }

    function isSelfInviteJoin(familyId, memberId) {
      return isSignedIn()
        && memberId == request.auth.uid
        && request.resource.data.uid == request.auth.uid
        && inviteMatchesFamily(familyId)
        && memberRoleMatchesInvite()
        && inviteIsDeletedAfterJoin();
    }

    function isSelfCreatorBootstrap(familyId, memberId) {
      return isSignedIn()
        && memberId == request.auth.uid
        && request.resource.data.uid == request.auth.uid
        && isParentRole(request.resource.data.roleRaw)
        && isFamilyCreator(familyId);
    }

    function memberRoleUnchanged() {
      return 'roleRaw' in resource.data
        && 'roleRaw' in request.resource.data
        && request.resource.data.roleRaw == resource.data.roleRaw;
    }

    function memberUidUnchangedOrCanonical(memberId) {
      return (
          !('uid' in resource.data)
          && !('uid' in request.resource.data)
        )
        || (
          'uid' in resource.data
          && 'uid' in request.resource.data
          && request.resource.data.uid == resource.data.uid
        )
        || (
          !('uid' in resource.data)
          && request.resource.data.uid == memberId
        );
    }

    function isLegacySelfRoleRepair(familyId, memberId) {
      return isSignedIn()
        && memberId == request.auth.uid
        && isFamilyMember(familyId)
        && !('roleRaw' in resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['roleRaw'])
        && (
          (
            get(/databases/$(database)/documents/families/$(familyId)).data.createdBy
              == request.auth.uid
            && request.resource.data.roleRaw == 'Мама'
          )
          || (
            get(/databases/$(database)/documents/families/$(familyId)).data.createdBy
              != request.auth.uid
            && request.resource.data.roleRaw == 'Папа'
          )
        );
    }

    function requestedUserFamilyIdIsAuthorized() {
      return !('familyId' in request.resource.data)
        || (
          request.resource.data.familyId is string
          && (
            isFamilyMember(request.resource.data.familyId)
            || isFamilyCreator(request.resource.data.familyId)
            // Allows the join batch only when it also creates the caller's member doc.
            || isFamilyMemberAfter(request.resource.data.familyId)
          )
        );
    }

    function isValidDepartureCleanupCreate() {
      let familyId = request.resource.data.familyId;
      let uid = request.resource.data.uid;
      let removedMemberId = request.resource.data.removedMemberId;
      let memberPath = /databases/$(database)/documents/families/$(familyId)/members/$(removedMemberId);
      return isSignedIn()
        && request.resource.data.keys()
          .hasAll(['familyId', 'uid', 'removedMemberId', 'requestedAt'])
        && request.resource.data.keys()
          .hasOnly(['familyId', 'uid', 'removedMemberId', 'requestedAt'])
        && familyId is string
        && uid is string
        && removedMemberId is string
        && request.resource.data.requestedAt == request.time
        && exists(memberPath)
        && (
          removedMemberId == uid
          || ('uid' in get(memberPath).data && get(memberPath).data.uid == uid)
        )
        && !existsAfter(memberPath)
        && (request.auth.uid == uid || canManageFamilyRoster(familyId));
    }

    function userFamilyIdUnchanged() {
      return 'familyId' in resource.data
        && 'familyId' in request.resource.data
        && request.resource.data.familyId == resource.data.familyId;
    }

    function hasValidInviteData() {
      return request.resource.data.keys()
          .hasAll(['familyId', 'createdBy', 'expiresAt', 'roleRaw'])
        && request.resource.data.keys()
          .hasOnly(['familyId', 'createdBy', 'expiresAt', 'roleRaw'])
        && request.resource.data.familyId is string
        && request.resource.data.createdBy is string
        && request.resource.data.expiresAt is timestamp
        && request.resource.data.expiresAt > request.time
        // 10 min of client-clock-skew tolerance: expiresAt is client-computed
        // (Date() + 24h), so a device clock slightly ahead of the server must
        // not deny the write.
        && request.resource.data.expiresAt <= request.time + duration.value(24, 'h') + duration.value(10, 'm')
        && request.resource.data.roleRaw is string
        && request.resource.data.roleRaw in ['Мама', 'Папа', 'Няня', 'Бабушка'];
    }

    // Инвайт-код обязан нести ≥60 бит энтропии: MOMSY-XXXX-XXXX-XXXX над
    // 32-символьным алфавитом без визуально неоднозначных знаков. Прежние
    // шестисимвольные коды давали 2^30 и перебирались, а join по угаданному коду
    // выдаёт роль родителя — полный доступ к данным ребёнка и к ростеру.
    function isStrongInviteCode(code) {
      return code.matches('^MOMSY(-[A-HJ-NP-Z2-9]{4}){3}$');
    }

    function callerConsumesInvite(code, familyId, roleRaw) {
      return isSignedIn()
        && isStrongInviteCode(code)
        && familyExists(familyId)
        && !isFamilyMember(familyId)
        && getAfter(
          /databases/$(database)/documents/families/$(familyId)/members/$(request.auth.uid)
        ).data.uid == request.auth.uid
        && getAfter(
          /databases/$(database)/documents/families/$(familyId)/members/$(request.auth.uid)
        ).data.inviteCode == code
        && getAfter(
          /databases/$(database)/documents/families/$(familyId)/members/$(request.auth.uid)
        ).data.roleRaw == roleRaw
        && getAfter(
          /databases/$(database)/documents/users/$(request.auth.uid)
        ).data.familyId == familyId;
    }

    // Each user owns only their own doc. familyId may only point at a family the
    // caller is already authorised for via roster membership or creator bootstrap.
    match /users/{uid} {
      allow read:   if isSignedIn() && request.auth.uid == uid;
      allow create: if isSignedIn()
                    && request.auth.uid == uid
                    && requestedUserFamilyIdIsAuthorized();
      allow update: if isSignedIn()
                    && request.auth.uid == uid
                    && (userFamilyIdUnchanged() || requestedUserFamilyIdIsAuthorized());
      allow delete: if isSignedIn() && request.auth.uid == uid;
    }

    match /familyDepartureCleanups/{jobId} {
      allow get, list: if isSignedIn() && resource.data.uid == request.auth.uid;
      allow create: if isValidDepartureCleanupCreate();
      allow update, delete: if false;
    }

    // A signed-in user may look up ONE invite by its exact code to discover an
    // existing familyId to join. Owner-constrained queries/deletes support account
    // erasure without allowing callers to enumerate other families' codes.
    match /invites/{code} {
      allow get:    if isSignedIn()
                    // ПЕРВЫМ предикатом: `familyExists()` — биллируемое чтение
                    // даже при отказе, и перебор не должен его оплачивать.
                    && isStrongInviteCode(code)
                    && familyExists(resource.data.familyId)
                    && resource.data.expiresAt > request.time
                    && isActiveParentMember(resource.data.familyId, resource.data.createdBy);
      allow list:   if isSignedIn()
                    && resource.data.createdBy == request.auth.uid;
      allow create: if isSignedIn()
                    && isStrongInviteCode(code)
                    && hasValidInviteData()
                    && request.resource.data.createdBy == request.auth.uid
                    && canManageFamilyRoster(request.resource.data.familyId);
      allow delete: if isSignedIn()
                    && (
                      !exists(/databases/$(database)/documents/invites/$(code))
                      || resource.data.createdBy == request.auth.uid
                      || canManageFamilyRoster(resource.data.familyId)
                      || (
                        resource.data.expiresAt > request.time
                        && callerConsumesInvite(
                          code,
                          resource.data.familyId,
                          resource.data.roleRaw
                        )
                      )
                    );
    }

    match /families/{familyId} {
      allow read:   if belongsToFamily(familyId);
      allow create: if isSignedIn()
                    && request.resource.data.createdBy == request.auth.uid
                    && (
                      request.resource.data.bootstrapComplete == false
                      || isAtomicFamilyCreatorBootstrap(familyId)
                    );
      // Bootstrap may only move false -> true; otherwise a creator could reopen
      // bootstrap and recreate their member document.
      allow update: if (
                      (canManageFamilyRoster(familyId) || isFamilyCreator(familyId))
                      && request.resource.data.createdBy == resource.data.createdBy
                      && request.resource.data.bootstrapComplete == true
                      && request.resource.data.diff(resource.data).affectedKeys()
                        .hasOnly(['bootstrapComplete'])
                    )
                    || isCreatorSelfErasure(familyId);
      // Keep the parent as a non-reusable tombstone; trusted backends bypass rules.
      allow delete: if false;

      // Members roster. A joining member may create their own membership doc only
      // with a valid, unexpired invite code for this family; the family creator may
      // write their own doc during setup; Mom/Dad members may manage the roster.
      match /members/{memberId} {
        allow read:   if belongsToFamily(familyId);
        allow create: if isSelfCreatorBootstrap(familyId, memberId)
                      || (memberId == request.auth.uid
                          && request.resource.data.uid == request.auth.uid
                          && isAtomicFamilyCreatorBootstrap(familyId))
                      || isSelfInviteJoin(familyId, memberId);
        allow update: if memberUidUnchangedOrCanonical(memberId)
                      && (
                        canManageFamilyRoster(familyId)
                        || isLegacySelfRoleRepair(familyId, memberId)
                        || (isSignedIn()
                            && memberId == request.auth.uid
                            && isFamilyMember(familyId)
                            && memberRoleUnchanged())
                      );
        allow delete: if canManageFamilyRoster(familyId)
                      || (isSignedIn() && memberId == request.auth.uid);
      }

      match /babies/{babyId} {
        allow read: if canViewBabyStatus(familyId);
        allow create: if canManageFamilyRoster(familyId)
                      || isFamilyCreator(familyId)
                      || isAtomicFamilyCreatorBootstrap(familyId);
        allow update: if canManageFamilyRoster(familyId)
                      || isFamilyCreator(familyId);
        allow delete: if canManageFamilyRoster(familyId);

        match /{subcollection}/{document=**} {
          allow get: if canReadBabyCollection(familyId, subcollection)
                     || canListOwnAuthoredData(familyId);
          allow list: if canReadBabyCollection(familyId, subcollection)
                      || canListOwnAuthoredData(familyId);
          allow create: if (
                          !isPrivateWellbeingCollection(subcollection)
                          && (
                            canManageFamilyRoster(familyId)
                            || isFamilyCreator(familyId)
                            || isAtomicFamilyCreatorBootstrap(familyId)
                            || canCreateRoutineLog(familyId, subcollection)
                          )
                        )
                        || canCreatePrivateWellbeing(familyId, subcollection);
          allow update: if (
                          !isPrivateWellbeingCollection(subcollection)
                          && (
                            canManageFamilyRoster(familyId)
                            || isFamilyCreator(familyId)
                            || canUpdateRoutineLog(familyId, subcollection)
                            || anonymizesOwnAuthorMetadata(familyId)
                          )
                        )
                        || canUpdatePrivateWellbeing(familyId, subcollection);
          // ponytail: Nanny deletes stay parent-only until tombstones identify
          // both the source collection and author.
          allow delete: if (
                          !isPrivateWellbeingCollection(subcollection)
                          && canManageFamilyRoster(familyId)
                        )
                        || canDeletePrivateWellbeing(familyId, subcollection);
        }
      }
    }

    // LEGACY family-keyed log tree, still read/written during the per-baby migration
    // rollout. Remove this block once all clients have migrated to the per-baby path.
    match /babies/{familyId} {
      allow read, write: if canManageFamilyRoster(familyId);

      match /{subcollection}/{document=**} {
        allow get: if canReadBabyCollection(familyId, subcollection)
                   || canListOwnAuthoredData(familyId);
        allow list: if canReadBabyCollection(familyId, subcollection)
                    || canListOwnAuthoredData(familyId);
        allow create: if (
                        !isPrivateWellbeingCollection(subcollection)
                        && (
                          canManageFamilyRoster(familyId)
                          || canCreateRoutineLog(familyId, subcollection)
                        )
                      )
                      || canCreatePrivateWellbeing(familyId, subcollection);
        allow update: if (
                        !isPrivateWellbeingCollection(subcollection)
                        && (
                          canManageFamilyRoster(familyId)
                          || canUpdateRoutineLog(familyId, subcollection)
                          || anonymizesOwnAuthorMetadata(familyId)
                        )
                      )
                      || canUpdatePrivateWellbeing(familyId, subcollection);
        allow delete: if (
                        !isPrivateWellbeingCollection(subcollection)
                        && canManageFamilyRoster(familyId)
                      )
                      || canDeletePrivateWellbeing(familyId, subcollection);
      }
    }
  }
}
